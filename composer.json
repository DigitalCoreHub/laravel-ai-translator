{
  "name": "digitalcorehub/laravel-ai-translator",
  "description": "Find missing Laravel translation keys and fill them in with AI — OpenAI, DeepSeek, DeepL or Google Translate.",
  "keywords": ["laravel", "translation", "i18n", "localization", "ai", "openai", "deepl"],
  "homepage": "https://github.com/DigitalCoreHub/laravel-ai-translator",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/filesystem": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.25",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0",
    "phpstan/phpstan": "^2.0"
  },
  "suggest": {
    "digitalcorehub/laravel-toon": "Encodes LLM batch payloads as TOON tables instead of JSON (~40% fewer input tokens on large language files)."
  },
  "autoload": {
    "psr-4": {
      "DigitalCoreHub\\LaravelAiTranslator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DigitalCoreHub\\LaravelAiTranslator\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DigitalCoreHub\\LaravelAiTranslator\\AiTranslatorServiceProvider"
      ],
      "aliases": {
        "AiTranslator": "DigitalCoreHub\\LaravelAiTranslator\\Facades\\AiTranslator"
      }
    }
  },
  "scripts": {
    "test": "pest",
    "lint": "pint --test",
    "format": "pint",
    "analyse": "phpstan analyse"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
